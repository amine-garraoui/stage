# ============================================
# SECURITY CONFIGURATION TEMPLATE
# ============================================
# Copy this to .env.local and fill with your values
# NEVER commit .env.local to Git!

# API Keys (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEYS= #cqmq4jnEk-LrZ3GONnkmHTUJ-TNNice_e-qEd6yoFZc

# CORS: Which URLs can call your API
# Local: http://localhost:8501,http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Trusted hosts (prevent Host header injection)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Encryption
# Path to encryption key file (should be in .gitignore)
ENCRYPTION_KEY_FILE=.encryption_key

# Audit logging
AUDIT_LOG_PATH=data/audit.log
AUDIT_LOG_LEVEL=INFO

# Data sensitivity level
# Options: LOW (demo), MEDIUM (test), HIGH (production)
DATA_SENSITIVITY_LEVEL=HIGH

# HTTPS/TLS
# In production, always use HTTPS!
# Generate certificate: openssl req -x509 -newkey rsa:4096 -nodes -out cert.pem -keyout key.pem -days 365
# Then set:
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem
# FORCE_HTTPS=true

# Logging
LOG_LEVEL=INFO

# Database (for future expansion)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rsi_kpi
# DB_USER=rsi_user
# DB_PASSWORD=secure-password-here
