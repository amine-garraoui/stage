# RSI Sagemcom KPI Platform — Application Settings
# Copy this file to .env and adjust for your environment

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=RSI Sagemcom KPI Platform
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/db/rsi_kpi.db
DATABASE_ECHO=false

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
BCRYPT_ROUNDS=12

# ── File Handling ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION_DAYS=90

# ── Forecasting ───────────────────────────────────────────────────────────────
FORECAST_HORIZON_MONTHS=6
CONFIDENCE_INTERVAL=0.95
MIN_HISTORY_MONTHS=3

# ── Anomaly Detection ─────────────────────────────────────────────────────────
ANOMALY_ZSCORE_THRESHOLD=2.0
ANOMALY_SPIKE_PERCENT=25.0
